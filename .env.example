# Copy to ".env" and fill in. Never commit .env.

# Anthropic (research + scripts)
ANTHROPIC_API_KEY=

# ElevenLabs (voiceover)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Pexels (free stock B-roll)
PEXELS_API_KEY=

# YouTube upload uses OAuth, not a key. You provide two files (see README):
#   client_secret.json  - downloaded from Google Cloud Console
#   token.json          - created automatically on first authorized run
# Paths below are relative to this folder; usually leave as-is.
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=token.json

# Runway (optional — AI-generated B-roll instead of free Pexels stock).
# Real cost: ~$0.12/sec. Get a key at dev.runwayml.com (Get API Key).
RUNWAY_API_KEY=
